# Backend environment variables. Copy to Backend/.env (git-ignored). Never commit real keys.

# LLM providers, tried in this order: NVIDIA, Groq, OpenRouter. Set at least one to enable /ask and /chat_query.
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Postgres (ParadeDB). Use host "db" inside docker compose. Docker compose loads this file;
# for local python runs also `export DATABASE_URL=...` (only the LLM keys are read from this file directly).
DATABASE_URL=postgresql://ailse:ailse@localhost:5432/ailse

# Optional tuning (defaults shown)
# LLM_MIN_GAP=2.5
# LLM_DAILY_CAP=300
# RATE_OTHER_PER_MIN=60
# RATE_LLM_PER_MIN=10          # /ask and /chat_query
# RATE_SEARCH_PER_MIN=10       # /query and /search (embedding + rerank, so strict)
# RATE_STATIC_PER_MIN=300      # PDFs and the built frontend files
# INFER_CONCURRENCY=1
# INFER_QUEUE_TIMEOUT=5        # seconds a search waits for the model before HTTP 503
# DB_POOL_MAX=10               # Postgres connections per process (keep below max_connections)
# RERANK_DEPTH=50
# PDF_BASE_URL=https://objectstorage.ap-hyderabad-1.oraclecloud.com/n/axcqgvveerc4/b/kanoon-pdfs/o
# LLM_DAILY_PER_IP=20          # per client per UTC day
# LLM_DAILY_RESERVE=30         # last N global calls only for clients with few calls today
# LLM_RESERVE_PER_IP=3
# LLM_DEADLINE=30              # seconds per request across providers and retries
# LLM_CONCURRENCY=3            # simultaneous LLM calls; more get HTTP 503
# RETENTION_DAYS=30            # searches and answer_cache older than this are deleted daily
# IP_HASH_SALT=                # set a long random value; salts the client hash stored in searches
# HEALTH_TOKEN=                # if set, GET /health with header X-Health-Token returns details
# HEALTH_DB_CHECK=1            # 0 = /health never queries the database
# ENVIRONMENT=production       # drops the localhost CORS origins
# ENABLE_DOCS=1                # serve /docs, /redoc, /openapi.json (off by default)
# DB_PASSWORD=ailse            # docker-compose.vm.yml only; change for any real deployment
# Extra browser origins allowed by CORS, comma-separated, exact origins (for example your Vercel domain)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# GROQ_MODEL=qwen/qwen3.8-27b   # check console.groq.com/docs/models; Groq retires models
