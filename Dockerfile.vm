# Kanoon single-origin image for the VM: React build (stage 1, discarded) + FastAPI serving API and static files.
# Build from the repo root:  docker build -f Dockerfile.vm .
FROM node:20-alpine AS web
WORKDIR /web
COPY Frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY Frontend/ ./
# empty VITE_API_URL = same-origin calls (/ask, /search, ...)
ENV VITE_API_URL=""
RUN npm run build

FROM python:3.10-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY Backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt
COPY Backend/model ./model
COPY Backend/citations_mining.py ./citations_mining.py
COPY Backend/supreme_court_cleaned_texts ./supreme_court_cleaned_texts
COPY --from=web /web/dist ./static
RUN useradd --create-home --shell /bin/bash app && mkdir /hf && chown -R app:app /app /hf
ENV PYTHONDONTWRITEBYTECODE=1 HF_HOME=/hf STATIC_DIR=/app/static PDF_DIR=/app/supreme_court_pdfs
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1
CMD ["python", "-m", "uvicorn", "model.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
