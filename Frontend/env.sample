# Copy to .env.local for local development. Never commit real values.

# --- API ---------------------------------------------------------------
# Origin of the Kanoon backend, no trailing slash.
# Leave empty or unset to call the same origin (backend serves this build).
# Vercel example: https://your-tunnel.ngrok-free.dev
# Local dev example: http://127.0.0.1:8000
VITE_API_URL=

# --- Firebase (optional, only needed for Google login and history) ------
# Public web config from Firebase console > Project settings > Your apps.
# If these are missing, the app still works: search and case pages are public,
# and the login page explains that login is unavailable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Links --------------------------------------------------------------
# GitHub repository shown in the footer and About page (optional).
# VITE_REPO_URL=https://github.com/thisis-gp/kanoon
